#!/bin/bash
set -euo pipefail

CONFIG_PATH="${HOTSPOT_PROXY_CONFIG:-$HOME/.config/hotspot-proxy-toggle.conf}"
LOG_PATH="${HOTSPOT_PROXY_LOG:-$HOME/Library/Logs/hotspot-proxy-toggle.log}"
STATE_PATH="${HOTSPOT_PROXY_STATE:-$HOME/Library/Application Support/hotspot-proxy-toggle/state}"
UI_STATE_PATH="${HOTSPOT_PROXY_UI_STATE:-$HOME/Library/Application Support/hotspot-proxy-toggle/status.json}"
SSID_CACHE_PATH="${HOTSPOT_PROXY_SSID_CACHE:-$HOME/Library/Application Support/hotspot-proxy-toggle/wifi-identity.json}"
NOTIFICATION_SENDER="${HOTSPOT_NOTIFICATION_SENDER:-$HOME/Applications/Mac Hotspot Proxy Toggle.app/Contents/MacOS/hotspot-proxy-toggle-menu}"

NETWORK_SERVICE="${NETWORK_SERVICE:-}"
WIFI_DEVICE="${WIFI_DEVICE:-}"
HOTSPOT_SSID="${HOTSPOT_SSID:-}"
PROXY_TYPE="${PROXY_TYPE:-socks5}"
PROXY_PORT="${PROXY_PORT:-}"
REQUIRE_PROXY_CHECK="${REQUIRE_PROXY_CHECK:-1}"
PROXY_CHECK_TIMEOUT="${PROXY_CHECK_TIMEOUT:-3}"
DRY_RUN="${DRY_RUN:-0}"
REQUESTED_DRY_RUN="$DRY_RUN"
NOTIFY_ON_CHANGE="${NOTIFY_ON_CHANGE:-0}"
LANGUAGE="${LANGUAGE:-}"
NOTIFICATION_LOCALE="${NOTIFICATION_LOCALE:-}"
PROXY_STATE_CHANGED=0
RUNTIME_DIR="${HOTSPOT_PROXY_RUNTIME_DIR:-$HOME/Library/Application Support/hotspot-proxy-toggle/managed}"
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  target="$(/usr/bin/readlink "$SCRIPT_PATH")"
  case "$target" in
    /*) SCRIPT_PATH="$target" ;;
    *) SCRIPT_PATH="$(/usr/bin/dirname "$SCRIPT_PATH")/$target" ;;
  esac
done
PROXY_LIBRARY="$(cd "$(/usr/bin/dirname "$SCRIPT_PATH")/../lib/hotspot-proxy-toggle" && pwd -P)/proxy.rb"

usage() {
  cat <<'EOF'
Usage:
  hotspot-proxy-toggle run
  hotspot-proxy-toggle status
  hotspot-proxy-toggle evaluate
  hotspot-proxy-toggle off
  hotspot-proxy-toggle stop
  hotspot-proxy-toggle resume

Config:
  ~/.config/hotspot-proxy-toggle.conf

Required:
  PROXY_TYPE=socks5|http
  PROXY_PORT=1080

Optional:
  HOTSPOT_SSID='My Phone'
  REQUIRE_PROXY_CHECK=1
  PROXY_CHECK_TIMEOUT=3
  NETWORK_SERVICE='Wi-Fi' # override only; auto-detected by default
  WIFI_DEVICE='en0'
  DRY_RUN=1
  NOTIFY_ON_CHANGE=1
  LANGUAGE=auto
  HOTSPOT_PROXY_STATE="$HOME/Library/Application Support/hotspot-proxy-toggle/state"
  HOTSPOT_PROXY_UI_STATE="$HOME/Library/Application Support/hotspot-proxy-toggle/status.json"
  HOTSPOT_NOTIFICATION_SENDER="$HOME/Applications/Mac Hotspot Proxy Toggle.app/Contents/MacOS/hotspot-proxy-toggle-menu"
EOF
}

log() {
  /bin/mkdir -p "$(/usr/bin/dirname "$LOG_PATH")"
  printf '%s %s\n' "$(/bin/date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_PATH"
}

load_config() {
  if [[ -f "$CONFIG_PATH" ]]; then
    load_config_file "$CONFIG_PATH"
  fi

  NETWORK_SERVICE="${NETWORK_SERVICE:-}"
  WIFI_DEVICE="${WIFI_DEVICE:-}"
  HOTSPOT_SSID="${HOTSPOT_SSID:-}"
  PROXY_TYPE="${PROXY_TYPE:-socks5}"
  PROXY_PORT="${PROXY_PORT:-}"
  REQUIRE_PROXY_CHECK="${REQUIRE_PROXY_CHECK:-1}"
  PROXY_CHECK_TIMEOUT="${PROXY_CHECK_TIMEOUT:-3}"
  DRY_RUN="${DRY_RUN:-0}"
  if [[ "$REQUESTED_DRY_RUN" == "1" ]]; then DRY_RUN=1; fi
  NOTIFY_ON_CHANGE="${NOTIFY_ON_CHANGE:-0}"
  LANGUAGE="${LANGUAGE:-${NOTIFICATION_LOCALE:-auto}}"
  if [[ "$LANGUAGE" != "auto" ]]; then
    NOTIFICATION_LOCALE="$LANGUAGE"
  else
    NOTIFICATION_LOCALE="${NOTIFICATION_LOCALE:-auto}"
  fi
  STATE_PATH="${HOTSPOT_PROXY_STATE:-${STATE_PATH:-$HOME/Library/Application Support/hotspot-proxy-toggle/state}}"
  UI_STATE_PATH="${HOTSPOT_PROXY_UI_STATE:-${UI_STATE_PATH:-$HOME/Library/Application Support/hotspot-proxy-toggle/status.json}}"
  SSID_CACHE_PATH="${HOTSPOT_PROXY_SSID_CACHE:-${SSID_CACHE_PATH:-$HOME/Library/Application Support/hotspot-proxy-toggle/wifi-identity.json}}"
  NOTIFICATION_SENDER="${HOTSPOT_NOTIFICATION_SENDER:-${NOTIFICATION_SENDER:-$HOME/Applications/Mac Hotspot Proxy Toggle.app/Contents/MacOS/hotspot-proxy-toggle-menu}}"
}

load_config_file() {
  local path="$1"
  local line trimmed key raw value

  while IFS= read -r line || [[ -n "$line" ]]; do
    trimmed="$(trim "$line")"
    [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue
    [[ "$trimmed" == *=* ]] || continue

    key="$(trim "${trimmed%%=*}")"
    raw="$(trim "${trimmed#*=}")"
    [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue
    value="$(parse_config_value "$raw")"

    case "$key" in
      NETWORK_SERVICE) NETWORK_SERVICE="$value" ;;
      WIFI_DEVICE) WIFI_DEVICE="$value" ;;
      HOTSPOT_SSID) HOTSPOT_SSID="$value" ;;
      PROXY_TYPE) PROXY_TYPE="$value" ;;
      PROXY_PORT) PROXY_PORT="$value" ;;
      REQUIRE_PROXY_CHECK) REQUIRE_PROXY_CHECK="$value" ;;
      PROXY_CHECK_TIMEOUT) PROXY_CHECK_TIMEOUT="$value" ;;
      DRY_RUN) DRY_RUN="$value" ;;
      NOTIFY_ON_CHANGE) NOTIFY_ON_CHANGE="$value" ;;
      LANGUAGE) LANGUAGE="$value" ;;
      NOTIFICATION_LOCALE) NOTIFICATION_LOCALE="$value" ;;
      HOTSPOT_PROXY_STATE) STATE_PATH="$value" ;;
      HOTSPOT_PROXY_UI_STATE) UI_STATE_PATH="$value" ;;
      HOTSPOT_NOTIFICATION_SENDER) NOTIFICATION_SENDER="$value" ;;
    esac
  done <"$path"
}

parse_config_value() {
  local raw="$1"
  local value

  if [[ "${#raw}" -ge 2 && "$raw" == \'* && "$raw" == *\' ]]; then
    value="${raw:1:${#raw}-2}"
    value="${value//\'\\\'\'/\'}"
    printf '%s' "$value"
    return 0
  fi

  if [[ "${#raw}" -ge 2 && "$raw" == \"* && "$raw" == *\" ]]; then
    value="${raw:1:${#raw}-2}"
    value="${value//\\\"/\"}"
    value="${value//\\\\/\\}"
    printf '%s' "$value"
    return 0
  fi

  value="${raw//\\ / }"
  printf '%s' "$value"
}

validate_config() {
  if [[ ! "$PROXY_CHECK_TIMEOUT" =~ ^[1-9][0-9]*$ ]]; then
    printf 'invalid proxy timeout\n' >&2
    return 64
  fi
  if [[ -n "$PROXY_PORT" ]]; then
    if [[ ! "$PROXY_PORT" =~ ^[0-9]{1,5}$ ]] || ((10#$PROXY_PORT < 1 || 10#$PROXY_PORT > 65535)); then
      printf 'invalid proxy port\n' >&2
      return 64
    fi
    PROXY_PORT=$((10#$PROXY_PORT))
  fi
  case "$PROXY_TYPE" in
    socks5|http) ;;
    *)
      printf 'unsupported PROXY_TYPE: %s (supported: socks5, http)\n' "$PROXY_TYPE" >&2
      return 64
      ;;
  esac

  case "$NOTIFICATION_LOCALE" in
    auto|en|ko) ;;
    *)
      printf 'unsupported NOTIFICATION_LOCALE: %s (supported: auto, en, ko)\n' "$NOTIFICATION_LOCALE" >&2
      return 64
      ;;
  esac

  case "$LANGUAGE" in
    auto|en|ko) ;;
    *)
      printf 'unsupported LANGUAGE: %s (supported: auto, en, ko)\n' "$LANGUAGE" >&2
      return 64
      ;;
  esac
}

wifi_device_from_hardware_ports() {
  /usr/sbin/networksetup -listallhardwareports |
    /usr/bin/awk '
      /^Hardware Port: Wi-Fi$/ { in_wifi = 1; next }
      /^Hardware Port:/ { in_wifi = 0 }
      in_wifi && /^Device:/ { print $2; exit }
    '
}

wifi_network_service_from_device() {
  local dev="$1"

  /usr/sbin/networksetup -listnetworkserviceorder |
    /usr/bin/awk -v dev="$dev" '
      /^\([0-9]+\) / {
        service = $0
        sub(/^\([0-9]+\) /, "", service)
        sub(/^\*/, "", service)
        next
      }
      index($0, "Device: " dev ")") > 0 {
        print service
        exit
      }
    '
}

ensure_network_service() {
  local wifi_dev="${WIFI_DEVICE:-}"
  local service

  if [[ -n "$NETWORK_SERVICE" ]]; then
    return 0
  fi

  if [[ -z "$wifi_dev" ]]; then
    wifi_dev="$(wifi_device_from_hardware_ports)"
  fi

  if [[ -z "$wifi_dev" ]]; then
    log "network service unavailable: no Wi-Fi device"
    return 1
  fi

  service="$(wifi_network_service_from_device "$wifi_dev")"
  if [[ -z "$service" ]]; then
    log "network service unavailable for Wi-Fi device $wifi_dev"
    return 1
  fi

  WIFI_DEVICE="$wifi_dev"
  NETWORK_SERVICE="$service"
}

default_interface() {
  /sbin/route -n get default 2>/dev/null |
    /usr/bin/awk '/interface:/ { print $2; exit }'
}

ipconfig_summary() {
  local dev="$1"
  /usr/sbin/ipconfig getsummary "$dev" 2>/dev/null || true
}

extract_summary_field() {
  local field="$1"
  /usr/bin/awk -v field="$field" '
    {
      key = $1
      sub(/:.*/, "", key)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      if (key == field) {
        value = $0
        sub(/^[^:]*:[ \t]*/, "", value)
        print value
        exit
      }
    }
  '
}

ssid_from_identity_cache() {
  local wifi_dev="$1"
  local connection_id="$2"
  local cached_dev cached_connection cached_ssid

  [[ -n "$connection_id" && -r "$SSID_CACHE_PATH" ]] || return 1

  cached_dev="$(/usr/bin/plutil -extract wifi_device raw -o - "$SSID_CACHE_PATH" 2>/dev/null || true)"
  cached_connection="$(/usr/bin/plutil -extract connection_id raw -o - "$SSID_CACHE_PATH" 2>/dev/null || true)"
  cached_ssid="$(/usr/bin/plutil -extract ssid raw -o - "$SSID_CACHE_PATH" 2>/dev/null || true)"

  [[ "$cached_dev" == "$wifi_dev" && "$cached_connection" == "$connection_id" && -n "$cached_ssid" ]] || return 1
  printf '%s' "$cached_ssid"
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

current_socks5_proxy_state() {
  /usr/sbin/networksetup -getsocksfirewallproxy "$NETWORK_SERVICE"
}

current_http_proxy_state() {
  printf 'Web Proxy:\n'
  /usr/sbin/networksetup -getwebproxy "$NETWORK_SERVICE"
  printf 'Secure Web Proxy:\n'
  /usr/sbin/networksetup -getsecurewebproxy "$NETWORK_SERVICE"
}

current_proxy_state() {
  case "$PROXY_TYPE" in
    socks5) current_socks5_proxy_state ;;
    http) current_http_proxy_state ;;
  esac
}

endpoint_result() {
  /usr/bin/ruby "$PROXY_LIBRARY" probe "$PROXY_TYPE" "$1" "$PROXY_PORT" "$PROXY_CHECK_TIMEOUT"
}

proxy_operation() {
  /usr/bin/ruby "$PROXY_LIBRARY" "$1" "$RUNTIME_DIR/session.json" "$NETWORK_SERVICE" "$PROXY_TYPE" "${2:-}" "$PROXY_PORT" "$DRY_RUN"
}

change_proxies() {
  local effect
  if ! effect="$(proxy_operation "$@")"; then
    case "$effect" in
      external_change|protected_endpoint) write_ui_state error "$effect" ;;
      *) write_ui_state error apply_failed ;;
    esac
    return 1
  fi
  if [[ "$effect" == "changed" ]]; then mark_proxy_changed; fi
}

proxy_check_ok_label() {
  case "$PROXY_TYPE" in
    socks5) printf 'socks5-ok' ;;
    http) printf 'http-ok' ;;
  esac
}

proxy_check_missing_label() {
  case "$PROXY_TYPE" in
    socks5) printf 'socks5-missing' ;;
    http) printf 'http-missing' ;;
  esac
}

proxy_display_name() {
  case "$PROXY_TYPE" in
    socks5) printf 'SOCKS5' ;;
    http) printf 'HTTP' ;;
  esac
}

mark_proxy_changed() {
  PROXY_STATE_CHANGED=1
}

apple_script_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

notification_state_changed() {
  local state_key="$1"
  local previous_state=""

  if [[ "$PROXY_STATE_CHANGED" == "1" ]]; then
    return 0
  fi

  if [[ -f "$STATE_PATH" ]]; then
    previous_state="$(<"$STATE_PATH")"
  fi

  [[ "$previous_state" != "$state_key" ]]
}

write_notification_state() {
  local state_key="$1"

  /bin/mkdir -p "$(/usr/bin/dirname "$STATE_PATH")" || {
    log "notification state write skipped: failed to create state directory"
    return 0
  }
  printf '%s\n' "$state_key" >"$STATE_PATH" ||
    log "notification state write failed: $STATE_PATH"
}

resolve_notification_locale() {
  local lang locale

  case "$NOTIFICATION_LOCALE" in
    en|ko)
      printf '%s' "$NOTIFICATION_LOCALE"
      return 0
      ;;
  esac

  lang="$(
    /usr/bin/defaults read -g AppleLanguages 2>/dev/null |
      /usr/bin/awk -F'[", ]+' '
        {
          for (i = 1; i <= NF; i++) {
            if ($i ~ /^[A-Za-z][A-Za-z]([-_][A-Za-z0-9]+)?$/) {
              print $i
              exit
            }
          }
        }
      '
  )"
  locale="$(/usr/bin/defaults read -g AppleLocale 2>/dev/null || true)"

  case "$lang:$locale" in
    ko*:*|*:ko*) printf 'ko' ;;
    *) printf 'en' ;;
  esac
}

notification_title() {
  local kind="$1"
  local locale

  locale="$(resolve_notification_locale)"
  case "$locale:$kind" in
    ko:on) printf '✅ 핫스팟 프록시 켜짐' ;;
    ko:unavailable) printf '⚠️ 핫스팟 프록시 사용 불가' ;;
    ko:idle) printf 'ℹ️ 핫스팟 대기' ;;
    en:on) printf '✅ Hotspot Proxy On' ;;
    en:unavailable) printf '⚠️ Hotspot Proxy Unavailable' ;;
    en:idle) printf 'ℹ️ Hotspot Proxy Idle' ;;
  esac
}

active_notification_body() {
  case "$(resolve_notification_locale)" in
    ko) printf 'Mac에 핫스팟 프록시 설정이 적용됐습니다.' ;;
    *) printf 'The hotspot proxy settings are applied on this Mac.' ;;
  esac
}

unavailable_notification_body() {
  case "$(resolve_notification_locale):${1:-}" in
    ko:authentication_required) printf '프록시 서버가 인증을 요구합니다.' ;;
    en:authentication_required) printf 'The proxy requires authentication.' ;;
    ko:*) printf 'Mac에서 프록시 연결을 확인하지 못했습니다.' ;;
    *) printf 'This Mac could not confirm the proxy connection.' ;;
  esac
}

inactive_notification_body() {
  local result="$1"
  local locale

  locale="$(resolve_notification_locale)"
  if [[ "$locale" == "ko" ]]; then
    case "$result" in
      status=not-hotspot*) printf '현재 Wi-Fi는 설정한 핫스팟이 아닙니다.' ;;
      *) printf '핫스팟이 활성 상태가 아닙니다.' ;;
    esac
    return 0
  fi

  case "$result" in
    status=not-hotspot*) printf 'Current Wi-Fi is not a configured hotspot.' ;;
    *) printf 'Hotspot is not active.' ;;
  esac
}

send_macos_notification() {
  local title="$1"
  local body="$2"
  local escaped_title escaped_body

  if [[ -x "$NOTIFICATION_SENDER" ]] &&
     "$NOTIFICATION_SENDER" --notify --title "$title" --body "$body" >/dev/null 2>&1; then
    return 0
  fi

  if [[ ! -x /usr/bin/osascript ]]; then
    log "notification skipped: osascript not found"
    return 0
  fi

  escaped_title="$(apple_script_escape "$title")"
  escaped_body="$(apple_script_escape "$body")"

  /usr/bin/osascript \
    -e "display notification \"$escaped_body\" with title \"$escaped_title\"" \
    >/dev/null 2>&1 ||
    log "notification failed: $title"
}

notify_reconcile_change() {
  local state_key="$1"
  local subtitle="$2"
  local body="$3"

  if [[ "$NOTIFY_ON_CHANGE" != "1" || "$DRY_RUN" == "1" ]]; then
    return 0
  fi

  if notification_state_changed "$state_key"; then
    send_macos_notification "$subtitle" "$body"
  fi

  write_notification_state "$state_key"
}

record_reconcile_state() {
  local state_key="$1"

  if [[ "$NOTIFY_ON_CHANGE" != "1" || "$DRY_RUN" == "1" ]]; then
    return 0
  fi

  write_notification_state "$state_key"
}

write_ui_state() {
  local kind="$1"
  local detail="${2:-}"
  local tmp

  printf 'ui_state=%s detail=%s\n' "$kind" "$detail"
  if [[ "$DRY_RUN" == "1" ]]; then
    return 0
  fi

  /bin/mkdir -p "$(/usr/bin/dirname "$UI_STATE_PATH")" || {
    log "ui state write skipped: failed to create state directory"
    return 0
  }

  tmp="$UI_STATE_PATH.$$"
  if {
    printf '{\n'
    printf '  "version": 2,\n'
    printf '  "kind": "%s",\n' "$kind"
    printf '  "proxy_type": "%s",\n' "$PROXY_TYPE"
    printf '  "detail": "%s",\n' "$detail"
    printf '  "updated_at": "%s"\n' "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf '}\n'
  } >"$tmp" && /bin/mv "$tmp" "$UI_STATE_PATH"; then
    return 0
  fi

    log "ui state write failed: $UI_STATE_PATH"
}

evaluate() {
  local wifi_dev="${WIFI_DEVICE:-}"
  local def_if summary router ssid connection_id reason

  if [[ -z "$wifi_dev" ]]; then
    wifi_dev="$(wifi_device_from_hardware_ports)"
  fi

  if [[ -z "$wifi_dev" ]]; then
    printf 'status=not-wifi reason=no-wifi-device\n'
    return 2
  fi
  WIFI_DEVICE="$wifi_dev"

  def_if="$(default_interface)"
  if [[ "$def_if" != "$wifi_dev" ]]; then
    printf 'status=not-wifi wifi_device=%s default_interface=%s\n' "$wifi_dev" "${def_if:-none}"
    return 1
  fi

  summary="$(ipconfig_summary "$wifi_dev")"
  router="$(printf '%s\n' "$summary" | extract_summary_field Router)"
  ssid="$(printf '%s\n' "$summary" | extract_summary_field SSID)"
  connection_id="$(printf '%s\n' "$summary" | extract_summary_field ConnectionID)"

  if [[ "$ssid" == "<redacted>" || -z "$ssid" ]]; then
    ssid="$(ssid_from_identity_cache "$wifi_dev" "$connection_id" || true)"
  fi

  if [[ -z "$router" ]]; then
    printf 'status=no-router wifi_device=%s ssid=%q\n' "$wifi_dev" "${ssid:-unknown}"
    return 1
  fi

  reason="no-match"

  if [[ -z "$HOTSPOT_SSID" ]]; then
    reason="no-hotspot-ssid"
  elif [[ -z "$ssid" ]]; then
    reason="ssid-unknown"
  elif [[ "$ssid" == "$HOTSPOT_SSID" ]]; then
    reason="ssid"
    printf 'status=hotspot reason=%s wifi_device=%s router=%s ssid=%q' "$reason" "$wifi_dev" "$router" "${ssid:-unknown}"
    printf '\n'
    if [[ "${1:-}" == "--with-identity" ]]; then printf 'connection_id=%q\n' "$connection_id"; fi
    return 0
  fi

  printf 'status=not-hotspot wifi_device=%s router=%s ssid=%q reason=%s\n' "$wifi_dev" "$router" "${ssid:-unknown}" "$reason"
  return 1
}

router_from_evaluation() {
  /usr/bin/awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^router=/) { print substr($i, 8); exit } }'
}

do_evaluate() {
  load_config
  validate_config
  evaluate
}

# Both observation and reconciliation use the same network and endpoint facts.
inspect_connection() {
  observed="$(evaluate --with-identity)" || true
  evaluation="${observed%%$'\n'*}"
  router=""
  probe=""
  case "$evaluation" in
    status=hotspot*)
      router="$(printf '%s\n' "$evaluation" | router_from_evaluation)"
      if [[ -z "$PROXY_PORT" ]]; then
        probe="port_missing"
      elif [[ "$REQUIRE_PROXY_CHECK" == "1" ]]; then
        probe="$(endpoint_result "$router")" || probe="connection_failed"
      else
        probe="unchecked"
      fi
      # The route or connection may have changed during the blocking probe.
      local latest
      latest="$(evaluate --with-identity)" || true
      if [[ "$latest" != "$observed" ]]; then
        observed="$latest"
        evaluation="${latest%%$'\n'*}"
        router=""
        probe="network_changed"
      fi
      ;;
  esac
  case "$evaluation" in
    status=hotspot*)
      case "$probe" in ready|unchecked) kind="on" ;; *) kind="unavailable" ;; esac ;;
    *reason=ssid-unknown|*reason=no-hotspot-ssid) kind="identity_unknown" ;;
    status=not-hotspot*) kind="idle" ;;
    status=not-wifi*|status=no-router*) kind="not_wifi" ;;
    *) kind="error" ;;
  esac
  printf '%s\n' "$evaluation"
}

do_status() {
  local observed evaluation router probe kind
  load_config
  validate_config
  if [[ -f "$RUNTIME_DIR/paused" ]]; then
    printf 'status=off action=paused\nui_state=off detail=manual\n'
    return
  fi
  inspect_connection
  if [[ "$kind" == "on" || "$kind" == "unavailable" ]]; then
    if [[ "$probe" == "ready" ]]; then
      printf 'proxy_check=%s router=%s port=%s\n' "$(proxy_check_ok_label)" "$router" "$PROXY_PORT"
    elif [[ "$probe" != "unchecked" ]]; then
      printf 'proxy_check=%s reason=%s\n' "$(proxy_check_missing_label)" "$probe"
    fi
  fi
  if ensure_network_service; then
    current_proxy_state
    if [[ "$kind" == "on" ]] && ! proxy_operation matches "$router"; then
      kind="unavailable"
      probe="not_applied"
    fi
  else
    kind="error"
    probe="network_service_unavailable"
    printf 'network_service=unavailable\n'
  fi
  printf 'ui_state=%s detail=%s\n' "$kind" "$probe"
}

do_run() {
  local observed evaluation router probe kind latest
  PROXY_STATE_CHANGED=0
  load_config
  validate_config
  if [[ -f "$RUNTIME_DIR/paused" ]]; then
    printf 'status=off action=paused\nui_state=off detail=manual\n'
    return
  fi
  if [[ -z "$PROXY_PORT" ]]; then
    write_ui_state error port_missing
    return 64
  fi
  inspect_connection
  if [[ -f "$RUNTIME_DIR/paused" ]]; then
    do_off
    return
  fi
  if [[ "$kind" == "on" ]]; then
    if ! ensure_network_service; then
      write_ui_state error network_service_unavailable
      return 1
    fi
    change_proxies apply "$router" || return 1
    latest="$(evaluate --with-identity)" || true
    if [[ -f "$RUNTIME_DIR/paused" ]]; then
      do_off
      return
    fi
    if [[ "$latest" != "$observed" ]]; then
      change_proxies restore || return 1
      write_ui_state checking network_changed
      return 0
    fi
    if [[ "$DRY_RUN" == "1" ]]; then
      printf 'DRY_RUN: would apply %s proxy on %s\n' "$PROXY_TYPE" "$NETWORK_SERVICE"
      return 0
    fi
    write_ui_state on
    notify_reconcile_change "on:$PROXY_TYPE:$evaluation" "$(notification_title on)" "$(active_notification_body)"
    return
  fi
  change_proxies restore || return 1
  if [[ "$DRY_RUN" == "1" ]]; then printf 'DRY_RUN: would restore app-managed proxy settings\n'; fi
  write_ui_state "$kind" "$probe"
  case "$kind" in
    unavailable)
      printf 'status=proxy-unavailable proxy_type=%s router=%s port=%s action=restore\n' "$PROXY_TYPE" "$router" "$PROXY_PORT"
      notify_reconcile_change "waiting:$PROXY_TYPE:$evaluation:$probe" "$(notification_title unavailable)" "$(unavailable_notification_body "$probe")" ;;
    idle)
      notify_reconcile_change "off:$PROXY_TYPE:$evaluation" "$(notification_title idle)" "$(inactive_notification_body "$evaluation")" ;;
    *) record_reconcile_state "off:$PROXY_TYPE:$evaluation" ;;
  esac
}

do_off() {
  load_config
  change_proxies restore || return 1
  write_ui_state off manual
  record_reconcile_state "off:$PROXY_TYPE:manual"
  printf 'status=off action=restore\n'
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    run|off|stop|resume)
      (umask 077 && /bin/mkdir -p "$RUNTIME_DIR") || return 1
      # Signal in-flight probes before waiting for their write lock.
      if [[ "$cmd" == "stop" ]]; then touch "$RUNTIME_DIR/paused" || return 1; fi
      exec /usr/bin/lockf -k "$RUNTIME_DIR/runtime.lock" /bin/bash "$SCRIPT_PATH" --locked "$cmd" ;;
    --locked)
      case "${2:-}" in
        run) do_run ;;
        off) do_off ;;
        stop) do_off ;;
        resume) /bin/rm -f "$RUNTIME_DIR/paused" ;;
        *) return 64 ;;
      esac ;;
    status) do_status ;;
    evaluate) do_evaluate ;;
    -h|--help|help|"") usage ;;
    *)
      usage >&2
      return 64
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
